{
  "name": "smart-form-autofiller",
  "version": "1.0.0",
  "description": "Chrome Extension that securely saves personal profiles and auto-fills web forms.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.config.content.ts && node scripts/copy-static.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.4.0",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "chrome-extension",
    "autofill",
    "form",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
